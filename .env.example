# ==========================================
# CRDISK — SaaS Platform Environment Setup
# ==========================================

# 1. Server & Gateway Config
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000/ws

# 2. Database Connection (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/crdisk_db?schema=public"

# 3. Redis Connection (Filas & Mensageria)
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. Meta WhatsApp Cloud API (Oficial)
WHATSAPP_PHONE_NUMBER_ID=104829104812903
WHATSAPP_WABA_ID=109823019283012
WHATSAPP_ACCESS_TOKEN=EAAG3k9Z0...
WHATSAPP_VERIFY_TOKEN=crm_whatsapp_verify_token_secure_99
WHATSAPP_API_VERSION=v20.0

# 5. Artificial Intelligence (OpenAI & Anthropic)
OPENAI_API_KEY=sk-proj-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=sk-ant-...

# 6. Telephony (Twilio Voice SDK & SIP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_API_KEY=your_twilio_api_key_here
TWILIO_API_SECRET=your_api_secret_here
TWILIO_TWIML_APP_SID=your_twilio_twiml_app_sid_here
TWILIO_CALLER_ID=+5511999999999

# SIP Configuration (Opcional - Asterisk / FreePBX)
SIP_SERVER=sip.crdisk.telecom.br
SIP_PORT=5060
SIP_EXTENSION=1001
SIP_PASSWORD=your_sip_password
