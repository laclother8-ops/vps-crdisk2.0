# =========================================================================
# 🔒 CRDISK SAAS - PRODUCTION ENVIRONMENT VARIABLES (.env.production)
# =========================================================================

# 1. Platform Domain & URLs
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_URL=https://app.crdisk.com.br
NEXT_PUBLIC_APP_URL=https://app.crdisk.com.br
NEXT_PUBLIC_API_URL=https://app.crdisk.com.br
NEXT_PUBLIC_WS_URL=wss://app.crdisk.com.br/ws

# 2. Database (PostgreSQL 16 com pgvector)
POSTGRES_USER=crdisk_prod_user
POSTGRES_PASSWORD=generate_super_strong_password_here_123!
POSTGRES_DB=crdisk_prod_db
DATABASE_URL=postgresql://crdisk_prod_user:generate_super_strong_password_here_123!@postgres:5432/crdisk_prod_db?schema=public

# 3. Redis (Cache, Filas & WebSockets)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_strong_redis_auth_token_here_456!
REDIS_URL=redis://:generate_strong_redis_auth_token_here_456!@redis:6379/0

# 4. Authentication & JWT Security Secrets
JWT_SECRET=generate_256_bit_random_jwt_secret_key_here_789!
SESSION_SECRET=generate_strong_cookie_signing_secret_here!

# 5. Meta WhatsApp Cloud API (Oficial)
WHATSAPP_PHONE_NUMBER_ID=104829104812903
WHATSAPP_WABA_ID=109823019283012
WHATSAPP_ACCESS_TOKEN=EAAG3k9Z0...
WHATSAPP_VERIFY_TOKEN=crdisk_webhook_verify_token_super_secret_2026
WHATSAPP_API_VERSION=v20.0

# 6. Artificial Intelligence (OpenAI GPT-4o-mini & pgvector RAG)
OPENAI_API_KEY=sk-proj-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=sk-ant-...

# 7. Gateways de Pagamento (Mercado Pago & Stripe)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
MERCADOPAGO_PUBLIC_KEY=APP_USR-...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 8. Telefonia WebRTC (Twilio Voice SDK & Tronco SIP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY=your_twilio_api_key_here
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_TWIML_APP_SID=your_twilio_twiml_app_sid_here
TWILIO_CALLER_ID=+5511999999999

# 9. Super Admin Inicial
INITIAL_SUPERADMIN_EMAIL=superadmin@crdisk.com.br
INITIAL_SUPERADMIN_PASSWORD=change_this_admin_password_immediately!
INITIAL_SUPERADMIN_NAME="Super Admin Master"
