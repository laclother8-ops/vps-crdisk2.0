datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// 1. Workspace / Tenant
model Workspace {
  id            String          @id @default(uuid())
  name          String          @db.VarChar(120)
  slug          String          @unique @db.VarChar(120)
  plan          String          @default("enterprise") @db.VarChar(30) // 'starter', 'pro', 'enterprise'
  status        String          @default("active") @db.VarChar(30)     // 'active', 'suspended'

  // Controle Financeiro & Assinatura SaaS
  subscriptionStatus            String    @default("pending_payment") @map("subscription_status") @db.VarChar(40) // 'trial', 'active', 'past_due', 'canceled', 'pending_payment'
  subscriptionPlan              String    @default("pro") @map("subscription_plan") @db.VarChar(40) // 'starter', 'pro', 'enterprise'
  trialEndsAt                   DateTime? @map("trial_ends_at")
  currentPeriodEnd              DateTime? @map("current_period_end")
  paymentGatewayCustomerId      String?   @map("payment_gateway_customer_id") @db.VarChar(120)
  paymentGatewaySubscriptionId  String?   @map("payment_gateway_subscription_id") @db.VarChar(120)

  // Integração com ERP Conta Azul
  contaAzulClientId             String?   @map("conta_azul_client_id") @db.VarChar(120)
  contaAzulClientSecret         String?   @map("conta_azul_client_secret") @db.VarChar(120)
  contaAzulAccessToken          String?   @map("conta_azul_access_token") @db.Text
  contaAzulRefreshToken         String?   @map("conta_azul_refresh_token") @db.Text
  contaAzulExpiresAt            DateTime? @map("conta_azul_expires_at")
  contaAzulEnabled              Boolean   @default(false) @map("conta_azul_enabled")

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  // Relacionamentos Multi-tenant
  users         User[]
  invites       WorkspaceInvite[]
  leads         Lead[]
  calls         Call[]
  messages      Message[]
  followUpJobs  FollowUpJob[]
  knowledgeBase KnowledgeBase[]
  products      Product[]
  orders        Order[]
  stockMovements StockMovement[]

  @@map("workspaces")
}

// 2. Usuário com RBAC
model User {
  id           String     @id @default(uuid())
  workspaceId  String?    @map("workspace_id") // Opcional apenas para Superadmin global
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(100)
  email        String     @unique @db.VarChar(120)
  passwordHash String     @map("password_hash") @db.Text
  role         String     @default("SALES_REP") @db.VarChar(30) // 'OWNER', 'ADMIN', 'SALES_REP', 'STOCK_OPERATOR', 'FINANCIAL', 'superadmin', 'workspace_admin', 'operator'
  sipExtension String?    @map("sip_extension") @db.VarChar(20)
  status       String     @default("active") @db.VarChar(20)   // 'active', 'inactive'
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relacionamentos
  assignedLeads Lead[]    @relation("AssignedLeads")
  orders        Order[]   @relation("UserOrders")
  calls         Call[]    @relation("AgentCalls")

  @@index([workspaceId])
  @@map("users")
}

// 3. Lead do CRM & Funil
model Lead {
  id             String        @id @default(uuid())
  workspaceId    String        @map("workspace_id")
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(120)
  phone          String        @db.VarChar(30)
  email          String?       @db.VarChar(120)
  company        String?       @db.VarChar(120)
  status         String        @default("nao_contatado") @db.VarChar(40) // 'nao_contatado', 'contatado', 'em_atendimento_humano', 'interessado', 'nao_interessado', 'cliente'
  funnelStage    String        @default("novo_lead") @map("funnel_stage") @db.VarChar(40) // 'novo_lead', 'qualificacao', 'apresentacao', 'proposta', 'fechado_ganho', 'perdido'
  lastCallStatus String?       @map("last_call_status") @db.VarChar(40)  // 'atendida', 'ocupado', 'caixa_postal', 'falha'
  optOut         Boolean       @default(false) @map("opt_out")
  assignedToId   String?       @map("assigned_to_id")
  assignedTo     User?         @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  tags           String[]      @default([])
  score          Int           @default(10)
  dealValue      Float         @default(0.0) @map("deal_value")

  // Inteligência de Recorrência & Pedidos
  lastOrderAt      DateTime?     @map("last_order_at")
  totalOrdersCount Int           @default(0) @map("total_orders_count")
  ltv              Decimal       @default(0.0) @db.Decimal(12, 2)

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relacionamentos
  calls          Call[]
  messages       Message[]
  followUpJobs   FollowUpJob[]
  orders         Order[]

  @@index([workspaceId])
  @@index([phone])
  @@map("leads")
}

// 4. Chamadas Telefônicas (WebRTC / SIP / Twilio)
model Call {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId       String    @map("lead_id")
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId      String?   @map("agent_id")
  agent        User?     @relation("AgentCalls", fields: [agentId], references: [id], onDelete: SetNull)
  duration     Int       @default(0) // Duração em segundos
  status       String    @db.VarChar(30) // 'answered', 'busy', 'no_answer', 'failed' (ou 'atendida', 'ocupado', 'caixa_postal', 'falha')
  recordingUrl String?   @map("recording_url") @db.Text
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([leadId])
  @@map("calls")
}

// 5. Mensagens Multicanal (WhatsApp Cloud API / Chat Live)
model Message {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId      String    @map("lead_id")
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender      String    @db.VarChar(20) // 'lead', 'ai', 'human'
  channel     String    @default("whatsapp") @db.VarChar(30) // 'whatsapp', 'chat_live'
  content     String    @db.Text
  type        String    @default("text") @db.VarChar(20) // 'text', 'audio', 'image', 'document'
  mediaUrl    String?   @map("media_url") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([leadId])
  @@map("messages")
}

// 6. Fila de Follow-up Inteligente (Jobs orientados a eventos)
model FollowUpJob {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadId       String    @map("lead_id")
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  triggerType  String    @map("trigger_type") @db.VarChar(50) // 'DISPOSITION_NAO_ATENDEU', 'DISPOSITION_OCUPADO', 'STAGE_PROPOSTA', 'MANUAL'
  scheduledFor DateTime  @map("scheduled_for")
  status       String    @default("pending") @db.VarChar(30) // 'pending', 'completed', 'cancelled'
  step         Int       @default(1)
  lastError    String?   @map("last_error") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([scheduledFor, status])
  @@map("followup_jobs")
}

// 7. Base de Conhecimento RAG com pgvector (Embeddings 1536 dimensões)
model KnowledgeBase {
  id          String                   @id @default(uuid())
  workspaceId String                   @map("workspace_id")
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String                   @db.VarChar(200)
  content     String                   @db.Text
  category    String                   @default("geral") @db.VarChar(50)
  vector      Unsupported("vector(1536)")?
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("knowledge_base")
}

// =========================================================================
// 8. CONTROLE DE VENDAS, ESTOQUE & ESTEIRA DE PEDIDOS
// =========================================================================

enum OrderStatus {
  DRAFT              // Rascunho / Novo Pedido
  AWAITING_PAYMENT   // Aguardando Pagamento
  PAID               // Pagamento Confirmado
  IN_PRODUCTION      // Separação de Estoque
  DISPATCHED         // Em Expedição / Em Trânsito
  DELIVERED          // Entregue / A Receber
  COMPLETED          // Concluído / Faturado
  CANCELED           // Cancelado / Estorno
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// 8.1 Produtos e Catálogo com Controle de Estoque
model Product {
  id                 String          @id @default(uuid())
  workspaceId        String          @map("workspace_id")
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String          @db.VarChar(150)
  sku                String          @db.VarChar(60)
  category           String          @default("Geral") @db.VarChar(80)
  price              Decimal         @db.Decimal(12, 2)
  costPrice          Decimal         @default(0.0) @map("cost_price") @db.Decimal(12, 2)
  stockQuantity      Int             @default(0) @map("stock_quantity")
  minStockAlert      Int             @default(5) @map("min_stock_alert")
  isActive           Boolean         @default(true) @map("is_active")
  contaAzulProductId String?         @map("conta_azul_product_id") @db.VarChar(100)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  orderItems         OrderItem[]
  stockMovements     StockMovement[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@map("products")
}

// 8.2 Pedido de Venda com 8 Etapas Kanban & Sincronização Conta Azul
model Order {
  id              String          @id @default(uuid())
  workspaceId     String          @map("workspace_id")
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId       String          @map("contact_id")
  contact         Lead            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  orderNumber     String          @unique @map("order_number") @db.VarChar(60)
  totalAmount     Decimal         @default(0.0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0.0) @map("discount_amount") @db.Decimal(12, 2)
  paymentMethod   String          @default("Pix") @map("payment_method") @db.VarChar(50)
  status          OrderStatus     @default(DRAFT)
  contaAzulSaleId String?         @map("conta_azul_sale_id") @db.VarChar(100)
  deliveryDate    DateTime?       @map("delivery_date")
  notes           String?         @db.Text
  assignedToId    String?         @map("assigned_to_id")
  assignedTo      User?           @relation("UserOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  items           OrderItem[]
  stockMovements  StockMovement[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([assignedToId])
  @@index([status])
  @@map("orders")
}

// 8.3 Itens do Pedido de Venda
model OrderItem {
  id             String    @id @default(uuid())
  orderId        String    @map("order_id")
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String    @map("product_id")
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int       @default(1)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(12, 2)
  totalItemPrice Decimal   @map("total_item_price") @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// 8.4 Histórico de Movimentações de Estoque
model StockMovement {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId   String            @map("product_id")
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  reason      String            @db.VarChar(255)
  orderId     String?           @map("order_id")
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([productId])
  @@map("stock_movements")
}

// 9. Convites de Membros para Equipe
model WorkspaceInvite {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String     @db.VarChar(120)
  name        String?    @db.VarChar(100)
  role        String     @default("SALES_REP") @db.VarChar(30)
  token       String     @unique @db.VarChar(128)
  expiresAt   DateTime   @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  acceptedAt  DateTime?  @map("accepted_at")

  @@index([workspaceId])
  @@index([token])
  @@map("workspace_invites")
}

